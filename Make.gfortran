FC = mpifort
LD = ${FC}
OPTIM = -O3 -ggdb -march=native

FFLAGS = -fdefault-real-8  -fopenmp

LIB_MPI = -lmpi
INC_MPI =

LIB_NETCDF = -lnetcdf -lnetcdff
INC_NETCDF =

LIB_PDAF = -Ldeps/pdaf/lib -lpdaf-d
INC_PDAF = -Ideps/pdaf/include

ESMF_DIR=deps/esmf/lib/libO/Linux.gfortran.64.openmpi.default
LIB_ESMF= -L${ESMF_DIR} -lesmf
include ${ESMF_DIR}/esmf.mk

LIB_LAPACK  = -lopenblas
LIBS += -lm -lcurl
